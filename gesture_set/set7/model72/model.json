{
    "version": "2.0",
    "model_name": "GestureNet_V2",
    "model_version": "2.0",
    "sequence_length": 36,
    "normalization": {
        "coordinate_mode": "cartesian",
        "power_mode": "db",
        "ranges": {
            "x": [-0.8, 0.8],
            "y": [0.0, 1.5],
            "z": [-0.75, 0],
            "doppler": [-2.5, 2.5],
            "power": [30.0, 55.0]
        }
    },
    "pipeline": [
        {
            "name": "PointNetV1",
            "type": "pointnet",
            "role": "frame_encoder",
            "param": "pointnet.param",
            "bin": "pointnet.bin",
            "input_name": "in0",
            "output_name": "out0",
            "output_size": 256,
            "use_cache": true
        },
        {
            "name": "CNNV1",
            "type": "cnn",
            "role": "temporal_aggregator",
            "param": "cnn.param",
            "bin": "cnn.bin",
            "input_name": "in0",
            "output_name": "out0",
            "output_size": 15
        }
    ],
    "dataset": {
        "name": "set7",
        "training_split": 0.8,
        "validation_split": 0.2,
        "learning_rate": 0.001,
        "batch_size": 32,
        "accumulation_steps": 2,
        "num_epochs": 22,
        "training_accuracy": 0.95,
        "validation_accuracy": 0.92
    }
}